# Postgres credentials — the single source of truth inside compose.
# The db, api, and mcp services all derive their connection settings from these.
POSTGRES_USER=cartograph
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cartograph

# DATABASE_URL is for host-run tools (alembic, pytest, the ingest/enrich
# CLIs), which auto-load this file — no exports needed. It points at the
# host-published dev port (127.0.0.1:5433). Inside compose it is derived from
# POSTGRES_* above — keep the user/password in sync.
DATABASE_URL=postgresql+asyncpg://cartograph:change-me@127.0.0.1:5433/cartograph

ANTHROPIC_API_KEY=            # tier-3 summaries/labels (slice 13)
# ENRICH_PROVIDER=claude-code  # route enrichment through the local Claude Code CLI (host-only)
VOYAGE_API_KEY=               # embeddings, voyage-code-3 (slice 13)
MCP_BEARER_TOKEN=change-me    # static token required by the MCP server (slice 09)
